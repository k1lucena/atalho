# Copy to .env only if you need to override the development defaults:
#   cp .env.example .env
# The values below are the same defaults docker-compose.yml already uses.

# --- Postgres ---
POSTGRES_DB=atalho
POSTGRES_USER=atalho
POSTGRES_PASSWORD=atalho
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_USER=atalho
RABBITMQ_PASSWORD=atalho
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
